# Claude Code — local / private (never commit)
.claude/settings.local.json
.claude/worktrees/
CLAUDE.local.md

# Codex — local / private config (never commit)
.codex/config.local.toml
.codex/*.local.*
.codex/secrets*

# Secrets / credentials (never commit)
.env
.env.*
*.local.env
**/secrets.json
**/credentials.json
aws-credentials*
*.pem

# Generated artifacts / exports / local reports (never commit)
artifacts/
!artifacts/.gitkeep
*.pdf
*.ics
local-reports/
screenshots/
.tmp-ai/
_source-intake/

# Dependencies (never commit; scripts/node_modules is historically tracked — see backlog)
node_modules/

# Operator Inbox — raw pasted stream responses (never commit real content)
operator-inbox/*.md
!operator-inbox/README.md
!operator-inbox/.gitkeep
operator-inbox/processed/*.md
!operator-inbox/processed/.gitkeep

# Operator Outbox — generated routing packets (never commit)
operator-outbox/*.md
operator-outbox/*.json
!operator-outbox/README.md
!operator-outbox/.gitkeep
