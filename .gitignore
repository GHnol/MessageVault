# Claude Code — local / private (never commit)
.claude/settings.local.json
.claude/worktrees/
CLAUDE.local.md

# Codex — local / private config (never commit)
.codex/config.local.toml
.codex/*.local.*
.codex/secrets*

# Secrets / credentials (never commit)
.env
.env.*
*.local.env
**/secrets.json
**/credentials.json
aws-credentials*
*.pem

# Generated artifacts / exports / local reports (never commit)
artifacts/
!artifacts/.gitkeep
*.pdf
*.ics
# Exception: the Project Control Tower calendar is repo-native source of truth (Package 2.8)
!docs/project-control/keepmees-project-calendar.ics
local-reports/
local-report-intake/
screenshots/
.tmp-ai/
_source-intake/

# Dependencies (never commit)
node_modules/
scripts/node_modules/

# Operator Inbox — raw pasted stream responses (never commit real content)
operator-inbox/*.md
!operator-inbox/README.md
!operator-inbox/.gitkeep
operator-inbox/processed/*.md
!operator-inbox/processed/.gitkeep

# Operator Outbox — generated routing packets (never commit)
operator-outbox/*.md
operator-outbox/*.json
!operator-outbox/README.md
!operator-outbox/.gitkeep

# IDE / OS / log noise (never commit)
*.log
.DS_Store
*.swp
*.swo
.idea/
.vscode/
claude-logs/
codex-logs/
.tmp-ai-*/

# Defensive Codex patterns (never commit)
.codex/skills/local/
.codex/sessions/

# Project control sync — local external ID maps (never commit; contains external tool IDs)
docs/project-control/external-sync-map.local.json

# Generated dry-run outputs (never commit; these are chat-output artifacts)
*.sync-dryrun.md
*.sync-dryrun.json
local-sync-reports/

# Claude notification config backups (never commit; user-level only)
*.claude-settings-backup-*.json

